+/* DXMT asks the driver for a Metal layer to draw into (escape codes used by Porting Kit's DXMT, same values) */
+#define MACDRV_ESCAPE_GET_SURFACE     0x1a86
+#define MACDRV_ESCAPE_RELEASE_SURFACE 0x1a87
+
+static INT macdrv_ExtEscape(PHYSDEV dev, INT escape, INT in_count, LPCVOID in, INT out_count, LPVOID out)
+{
+    switch (escape)
+    {
+    case QUERYESCSUPPORT:
+        if (in_count >= sizeof(INT))
+        {
+            INT code = *(const INT *)in;
+            if (code == MACDRV_ESCAPE_GET_SURFACE || code == MACDRV_ESCAPE_RELEASE_SURFACE) return 1;
+        }
+        return 0;
+
+    case MACDRV_ESCAPE_GET_SURFACE:
+    {
+        UINT64 *result = out;
+        struct macdrv_client_surface *surface;
+        HWND hwnd;
+
+        if (out_count < 2 * sizeof(UINT64) || !out) return 0;
+        if (!(hwnd = NtUserWindowFromDC(dev->hdc))) return 0;
+        if (!(surface = macdrv_client_surface_create(hwnd))) return 0;
+
+        /* window of another process (Steam's browser GPU process): publish an off-screen layer, let the owner host it */
+        {
+            HWND toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
+            struct macdrv_win_data *data = get_win_data(toplevel);
+            if (data) release_win_data(data);
+            else
+            {
+                RECT rect;
+                macdrv_metal_layer layer;
+                uint32_t context_id;
+
+                NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
+                if (!(surface->remote_layer = macdrv_create_remote_layer(cgrect_from_rect(rect), &layer, &context_id))) goto err;
+                surface->remote_toplevel = toplevel;
+                surface->remote_context_id = context_id;
+                NtUserPostMessage(toplevel, WM_MACDRV_SYNC_REMOTE_LAYER, (WPARAM)hwnd, context_id);
+                result[0] = (UINT_PTR)surface;
+                result[1] = (UINT_PTR)layer;
+                TRACE("hwnd %p remote surface %p layer %p context %u\n", hwnd, surface, layer, context_id);
+                return 1;
+            }
+        }
+
+        if (!(surface->metal_device = macdrv_create_metal_device())) goto err;
+        if (!(surface->metal_view = macdrv_view_create_metal_view(surface->cocoa_view, surface->metal_device))) goto err;
+
+        /* show the client view now: the game presents through Metal and never calls Wine's present */
+        client_surface_update(&surface->client);
+        client_surface_present(&surface->client);
+
+        result[0] = (UINT_PTR)surface;
+        result[1] = (UINT_PTR)macdrv_view_get_metal_layer(surface->metal_view);
+        TRACE("hwnd %p surface %p layer %p\n", hwnd, surface, (void *)(UINT_PTR)result[1]);
+        return 1;
+
+    err:
+        client_surface_release(&surface->client);
+        return 0;
+    }
+
+    case MACDRV_ESCAPE_RELEASE_SURFACE:
+        if (in_count < sizeof(UINT64) || !in) return 0;
+        client_surface_release(&((struct macdrv_client_surface *)(UINT_PTR)*(const UINT64 *)in)->client);
+        return 1;
+    }
+
+    return 0;
+}
