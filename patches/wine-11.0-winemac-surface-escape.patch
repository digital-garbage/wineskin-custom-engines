+/* Producer side: a Metal layer that is not in any window of this process but published as a CAContext */
+@interface WineRemoteLayer : NSObject
+{
+@public
+    CAMetalLayer *layer;
+    CAContext *context;
+    uint32_t contextId;
+}
+@end
+@implementation WineRemoteLayer
+@end
+
+macdrv_remote_layer macdrv_create_remote_layer(CGRect bounds, macdrv_metal_layer *out_layer, uint32_t *out_context_id)
+{
+    __block WineRemoteLayer *remote = nil;
+    OnMainThread(^{
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        if (!device) return;
+        WineRemoteLayer *r = [[WineRemoteLayer alloc] init];
+        r->layer = [[CAMetalLayer alloc] init];
+        r->layer.device = device;
+        r->layer.framebufferOnly = YES;
+        r->layer.magnificationFilter = kCAFilterNearest;
+        r->layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
+        r->layer.contentsScale = retina_on ? 2.0 : 1.0;
+        r->layer.bounds = CGRectMake(0, 0, bounds.size.width, bounds.size.height);
+        r->layer.anchorPoint = CGPointZero;
+        [device release];
+        r->context = [[CAContext contextWithCGSConnection:CGSMainConnectionID() options:@{}] retain];
+        [r->context setLayer:r->layer];
+        r->contextId = [r->context contextId];
+        if (!r->contextId) { [r->context setLayer:nil]; [r->context release]; [r->layer release]; [r release]; return; }
+        remote = r;
+    });
+    if (!remote) return NULL;
+    *out_layer = (macdrv_metal_layer)remote->layer;
+    *out_context_id = remote->contextId;
+    return (macdrv_remote_layer)remote;
+}
+
+void macdrv_release_remote_layer(macdrv_remote_layer rl)
+{
+    WineRemoteLayer *r = (WineRemoteLayer *)rl;
+    OnMainThread(^{
+        [r->context setLayer:nil];
+        [r->context release];
+        [r->layer release];
+        [r release];
+    });
+}
+
+/* Owner side: show / remove the other process's layer in this window */
+void macdrv_sync_remote_layer(macdrv_window w, uint32_t context_id, CGRect frame)
+{
+    WineWindow *window = (WineWindow *)w;
+    OnMainThread(^{
+        WineContentView *view = (WineContentView *)[window contentView];
+        if ([view isKindOfClass:[WineContentView class]])
+            [view syncCALayerHostWithContextId:context_id frame:cgrect_mac_from_win(frame)];
+    });
+}
+
+void macdrv_remove_remote_layer(macdrv_window w, uint32_t context_id)
+{
+    WineWindow *window = (WineWindow *)w;
+    OnMainThread(^{
+        WineContentView *view = (WineContentView *)[window contentView];
+        if ([view isKindOfClass:[WineContentView class]]) [view removeCALayerHostView:context_id];
+    });
+}
