+/* Games such as Skyrim open a 5.1 stream even on a stereo device. CoreAudio would play only the first two
+ * channels and lose the center (dialogue) and the surrounds, so mix them down to stereo here (ITU-R BS.775). */
+static BOOL ca_downmixing(const struct coreaudio_stream *stream)
+{
+    return stream->flow == eRender && stream->dev_desc.mChannelsPerFrame == 2 &&
+           stream->fmt->nChannels > 2 && stream->fmt->nChannels <= 32;
+}
+
+static void ca_downmix_frames(const struct coreaudio_stream *stream, float *dst, const float *src, UINT32 frames)
+{
+    /* gains by speaker position bit: FL FR FC LFE BL BR FLC FRC BC SL SR */
+    static const float gl[11] = {1, 0, .7071f, 0, .7071f, 0, .7071f, 0, .5f, .7071f, 0};
+    static const float gr[11] = {0, 1, .7071f, 0, 0, .7071f, 0, .7071f, .5f, 0, .7071f};
+    float cl[32] = {0}, cr[32] = {0};
+    UINT32 nch = stream->fmt->nChannels, ch = 0, bit, i, c;
+    DWORD mask = 0;
+
+    if(stream->fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+        mask = ((WAVEFORMATEXTENSIBLE *)stream->fmt)->dwChannelMask;
+    if(__builtin_popcount(mask) != nch)
+        mask = nch == 4 ? 0x33 : nch == 6 ? 0x3f : nch == 8 ? 0x63f : 0x3;
+    for(bit = 0; bit < 32 && ch < nch; bit++){
+        if(!(mask & (1u << bit))) continue;
+        if(bit < 11){ cl[ch] = gl[bit]; cr[ch] = gr[bit]; }
+        ch++;
+    }
+    for(i = 0; i < frames; i++, src += nch){
+        float l = 0, r = 0;
+        for(c = 0; c < nch; c++){ l += src[c] * cl[c]; r += src[c] * cr[c]; }
+        dst[2 * i]     = l > 1.0f ? 1.0f : l < -1.0f ? -1.0f : l;
+        dst[2 * i + 1] = r > 1.0f ? 1.0f : r < -1.0f ? -1.0f : r;
+    }
+}
