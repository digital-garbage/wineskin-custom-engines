+    if(stream->flow == eRender){
+        /* CoreAudio's default IO size (512 frames) is bigger than the 10 ms (441-480 frames) a client
+         * refills per period event; clients that keep only ~2 periods queued (native XAudio2) then run
+         * dry once per beat and the output chops. Use a smaller IO size, like Windows' 10 ms engine pull. */
+        const char *e = getenv("WINECA_IOFRAMES");
+        UInt32 io_frames = e ? atoi(e) : 256;
+        if(io_frames){
+            OSStatus st = AudioUnitSetProperty(stream->unit, kAudioDevicePropertyBufferFrameSize,
+                    kAudioUnitScope_Global, 0, &io_frames, sizeof(io_frames));
+            if(st != noErr) WARN("Couldn't set IO buffer size %u: %x\n", (unsigned)io_frames, (int)st);
+        }
+    }
