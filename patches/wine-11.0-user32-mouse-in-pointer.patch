diff --git a/dlls/user32/message.c b/dlls/user32/message.c
index 205d3e01..434ba74b 100644
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -705,12 +705,106 @@ BOOL WINAPI PostThreadMessageA( DWORD thread, UINT msg, WPARAM wparam, LPARAM lp
 }
 
 
+/* Mouse in pointer mode (EnableMouseInPointer), as in upstream Wine's win32u (commits 71b686ce, b94237cd):
+ * newer Unity versions turn it on and then only read clicks from WM_POINTER* messages. win32u in this
+ * engine cannot be rebuilt, so the pointer messages are sent here when a mouse message leaves the queue. */
+static LONG mouse_in_pointer = -1;
+
+/**********************************************************************
+ *		EnableMouseInPointer  (USER32.@)
+ */
+BOOL WINAPI EnableMouseInPointer( BOOL enable )
+{
+    LONG prev;
+
+    TRACE( "enable %u\n", enable );
+
+    if ((prev = InterlockedCompareExchange( &mouse_in_pointer, !!enable, -1 )) != -1 && prev != !!enable)
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/**********************************************************************
+ *		IsMouseInPointerEnabled  (USER32.@)
+ */
+BOOL WINAPI IsMouseInPointerEnabled(void)
+{
+    return ReadNoFence( &mouse_in_pointer ) == 1;
+}
+
+static WORD pointer_buttons_from_mouse_buttons( WORD mouse_flags )
+{
+    WORD flags = 0;
+
+    if (mouse_flags & MK_LBUTTON) flags |= POINTER_MESSAGE_FLAG_FIRSTBUTTON;
+    if (mouse_flags & MK_RBUTTON) flags |= POINTER_MESSAGE_FLAG_SECONDBUTTON;
+    if (mouse_flags & MK_MBUTTON) flags |= POINTER_MESSAGE_FLAG_THIRDBUTTON;
+    if (mouse_flags & MK_XBUTTON1) flags |= POINTER_MESSAGE_FLAG_FOURTHBUTTON;
+    if (mouse_flags & MK_XBUTTON2) flags |= POINTER_MESSAGE_FLAG_FIFTHBUTTON;
+    return flags;
+}
+
+static void send_mouse_in_pointer_message( const MSG *msg )
+{
+    WORD flags = POINTER_MESSAGE_FLAG_INRANGE, buttons;
+    UINT message = 0;
+
+    if (ReadNoFence( &mouse_in_pointer ) != 1 || !msg->hwnd) return;
+    if (msg->message < WM_MOUSEFIRST || msg->message > WM_MOUSELAST) return;
+    if ((GetMessageExtraInfo() & 0xffffff00) == 0xff515700) return; /* generated from touch input */
+
+    buttons = pointer_buttons_from_mouse_buttons( LOWORD( msg->wParam ));
+    if (buttons) flags |= buttons | POINTER_MESSAGE_FLAG_INCONTACT;
+
+    switch (msg->message)
+    {
+    case WM_MOUSEMOVE:
+        message = WM_POINTERUPDATE;
+        if (!buttons) flags |= POINTER_MESSAGE_FLAG_PRIMARY;
+        break;
+    case WM_LBUTTONDOWN:
+    case WM_RBUTTONDOWN:
+    case WM_MBUTTONDOWN:
+    case WM_XBUTTONDOWN:
+        /* WM_POINTERDOWN is only sent for the first button pressed */
+        if (buttons & (buttons - 1)) message = WM_POINTERUPDATE;
+        else
+        {
+            message = WM_POINTERDOWN;
+            flags |= POINTER_MESSAGE_FLAG_PRIMARY;
+        }
+        break;
+    case WM_LBUTTONUP:
+    case WM_RBUTTONUP:
+    case WM_MBUTTONUP:
+    case WM_XBUTTONUP:
+        /* WM_POINTERUP is only sent once all the buttons are up */
+        message = buttons ? WM_POINTERUPDATE : WM_POINTERUP;
+        break;
+    case WM_MOUSEWHEEL:
+        message = WM_POINTERWHEEL;
+        flags = HIWORD( msg->wParam );
+        break;
+    case WM_MOUSEHWHEEL:
+        message = WM_POINTERHWHEEL;
+        flags = HIWORD( msg->wParam );
+        break;
+    }
+
+    if (message) SendMessageW( msg->hwnd, message, MAKELONG( 1, flags ), MAKELONG( msg->pt.x, msg->pt.y ));
+}
+
 /***********************************************************************
  *		PeekMessageW  (USER32.@)
  */
 BOOL WINAPI DECLSPEC_HOTPATCH PeekMessageW( MSG *msg_out, HWND hwnd, UINT first, UINT last, UINT flags )
 {
-    return NtUserPeekMessage( msg_out, hwnd, first, last, flags );
+    BOOL ret = NtUserPeekMessage( msg_out, hwnd, first, last, flags );
+    if (ret && (flags & PM_REMOVE)) send_mouse_in_pointer_message( msg_out );
+    return ret;
 }
 
 
@@ -731,7 +825,9 @@ BOOL WINAPI DECLSPEC_HOTPATCH PeekMessageA( MSG *msg, HWND hwnd, UINT first, UIN
  */
 BOOL WINAPI DECLSPEC_HOTPATCH GetMessageW( MSG *msg, HWND hwnd, UINT first, UINT last )
 {
-    return NtUserGetMessage( msg, hwnd, first, last );
+    BOOL ret = NtUserGetMessage( msg, hwnd, first, last );
+    if (ret > 0) send_mouse_in_pointer_message( msg );
+    return ret;
 }
 
 
diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index 6333fcb4..da9c10e2 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -526,10 +526,34 @@ BOOL WINAPI GetPointerType(UINT32 id, POINTER_INPUT_TYPE *type)
 
 BOOL WINAPI GetPointerInfo(UINT32 id, POINTER_INFO *info)
 {
-    FIXME("(%d %p): stub\n", id, info);
+    static const struct { int vkey; POINTER_FLAGS flag; } buttons[] =
+    {
+        { VK_LBUTTON, POINTER_FLAG_FIRSTBUTTON }, { VK_RBUTTON, POINTER_FLAG_SECONDBUTTON },
+        { VK_MBUTTON, POINTER_FLAG_THIRDBUTTON }, { VK_XBUTTON1, POINTER_FLAG_FOURTHBUTTON },
+        { VK_XBUTTON2, POINTER_FLAG_FIFTHBUTTON },
+    };
+    unsigned int i;
 
-    SetLastError(ERROR_INVALID_PARAMETER);
-    return FALSE;
+    TRACE("(%d %p)\n", id, info);
+
+    /* only the mouse (pointer id 1, see EnableMouseInPointer) is known */
+    if (id != 1 || !info || !IsMouseInPointerEnabled())
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    memset(info, 0, sizeof(*info));
+    info->pointerType = PT_MOUSE;
+    info->pointerId = 1;
+    info->pointerFlags = POINTER_FLAG_INRANGE | POINTER_FLAG_PRIMARY;
+    for (i = 0; i < ARRAY_SIZE(buttons); i++)
+        if (NtUserGetKeyState(buttons[i].vkey) & 0x8000) info->pointerFlags |= buttons[i].flag | POINTER_FLAG_INCONTACT;
+    GetCursorPos(&info->ptPixelLocation);
+    info->ptPixelLocationRaw = info->ptPixelLocation;
+    info->hwndTarget = WindowFromPoint(info->ptPixelLocation);
+    info->dwTime = GetTickCount();
+    return TRUE;
 }
 
 LRESULT WINAPI ImeWndProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
